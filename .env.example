# Optional. Demo mode ignores this file.
# Live mode works with every key left blank; coverage is thinner and gaps are listed.
#
#   cp .env.example .env
#
# None of these are required.

# --- Roster (pick any; Wikipedia + TheSportsDB run without paid keys) ---
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# https://www.api-football.com
API_FOOTBALL_KEY=

# Free test key. Override only if you have a personal/premium TheSportsDB key.
# https://www.thesportsdb.com
THESPORTSDB_API_KEY=123

# --- News (Google News RSS and site RSS already run without these) ---
# https://newsapi.org
NEWSAPI_KEY=

# https://open-platform.theguardian.com
GUARDIAN_API_KEY=

# https://gnews.io
GNEWS_API_KEY=

# --- Social ---
# X/Twitter recent search (optional)
# https://developer.x.com
TWITTER_BEARER_TOKEN=

# Instagram Business Discovery (optional; social v1.1)
# Official Meta Graph API only. Personal accounts cannot be read. No name search.
# Long-lived User access token with Facebook Login permissions:
#   instagram_basic, instagram_manage_insights, pages_read_engagement
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-facebook-login/business-discovery
INSTAGRAM_ACCESS_TOKEN=
# IG user id of the observer professional (Business/Creator) account making queries
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Default true. Set false to skip Instagram even when credentials are present.
INSTAGRAM_ENABLED=true
# Graph API version (default v21.0; Meta samples currently use later versions such as v26.0)
INSTAGRAM_GRAPH_VERSION=v21.0
# Caps, consistent with the X collector (20 players / 10 tweets)
INSTAGRAM_MAX_PLAYERS=20
INSTAGRAM_MAX_MEDIA=10
# JSON object, JSON { "players": [...] }, or CSV with name,id,username columns.
# Copy config/instagram_handles.example.json — never invent missing handles.
INSTAGRAM_HANDLES_FILE=config/instagram_handles.json

# --- Analyzer (optional; cannot invent sources) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- HTTP ---
HTTP_USER_AGENT=SquadScreen/0.1 (+https://github.com; match-day readiness research)
HTTP_TIMEOUT_SECONDS=20
NEWS_CONCURRENCY=4
